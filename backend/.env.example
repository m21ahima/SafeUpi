# Copy this file to ".env" in the same folder and fill in real values.
# As long as this file is named ".env" (not ".env.example"), notifications.py
# will pick it up automatically on server start - no code changes needed.
#
# Leave everything blank/unset to keep running in simulated mode (OTPs are
# shown on-screen and messages are just logged to the console + saved in
# the Notifications list) - useful while you don't have credentials yet.

# ---- Email (OTP + transaction alerts) ----
# Easiest option: a free Gmail account.
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password:      myaccount.google.com/apppasswords
#   3. Fill in below (SMTP_PASS is the 16-character app password, not your
#      normal Gmail password).
SAFEUPI_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16characterapppassword
SMTP_FROM=youraddress@gmail.com

# ---- SMS (OTP + transaction alerts) ----
# Twilio's free trial is enough for a college demo, but trial accounts can
# only text phone numbers you've verified in the Twilio console first.
#   1. Sign up: twilio.com/try-twilio
#   2. Verify your own phone number under Phone Numbers > Verified Caller IDs
#   3. Copy your Account SID / Auth Token / trial number from the console
SAFEUPI_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567
